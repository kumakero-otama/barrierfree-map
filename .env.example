# This is a name-only example. Never commit real secrets or tokens.

NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3100
DB_CONFIG_PATH=/absolute/path/to/config.dev.yaml
EXPERIMENT_DB_CONFIG_PATH=/absolute/path/to/config.dev.yaml
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://example.github.io

# Google OpenID Connect
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRES_IN_SECONDS=604800

# Development administration
DEV_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_KEY

# OpenStreetMap read access
OVERPASS_HOST=overpass-api.de
OSM_API_BASE_URL=https://api.openstreetmap.org

# StepBy service-account OAuth. Keep writes disabled in a fresh environment.
OSM_OAUTH_CLIENT_ID=
OSM_OAUTH_CLIENT_SECRET=
OSM_OAUTH_REDIRECT_URI=https://YOUR_API_HOST/auth/osm/callback
OSM_SERVICE_OAUTH_ADMIN_RETURN_URL=https://YOUR_API_HOST/admin/database.html
OSM_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_RANDOM_ENCRYPTION_KEY
OSM_WRITES_ENABLED=false
OSM_COMMUNITY_APPROVED=false
OSM_AUTOMATED_EDIT_WIKI_URL=
OSM_CHANGESET_HASHTAG='#StepBy'
OSM_AUTOMATED_EDIT_TAG=mechanical
STEPBY_VERSION=development

# Database password is used by cloud/configure-cloud-db.sh and backup script.
STEPBY_DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD

# Cloud helper defaults can be overridden when reproducing in another project.
STEPBY_GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
STEPBY_RUNTIME_SECRET_ID=YOUR_SECRET_ID
STEPBY_BACKUP_BUCKET=YOUR_PRIVATE_BACKUP_BUCKET

# Legacy-only variables. UI10 normal recording does not use these.
MAPBOX_TOKEN=
VALHALLA_HOST=
VALHALLA_PORT=
TLS_KEY_PATH=
TLS_CERT_PATH=
# OSM公開審査（Gmailのアプリパスワード等はSecret Managerから注入し、Gitへ保存しない）
OSM_REVIEW_ADMIN_EMAIL=kumakero.otama@gmail.com
OSM_REVIEW_URL=https://stepby-api-8-229-191-182.sslip.io/admin/osm-review.html
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
